{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "radar-care-fleet-demo",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SNAPSHOT_CACHE_SECONDS": "10",
    "STREAM_INTERVAL_MS": "3000"
  }
}
